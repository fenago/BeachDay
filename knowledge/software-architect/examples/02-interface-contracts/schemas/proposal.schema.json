{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beachday.example/schemas/proposal.schema.json",
  "title": "ProposalRecord",
  "description": "Record stored in the Netlify Blobs `proposals` store (strong consistency) and returned by GET /api/proposals/:id. Shape check only: the server-side allow-list in netlify/functions/lib/allowlist.mts (normalise, DENY wins) and the secret scan remain the enforcement points, re-run at approve time (docs/04 §6-7, ADR-0003, ADR-0005).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "agent", "status", "createdAt", "baseSha", "summary", "files", "contentHash"],
  "properties": {
    "id": { "type": "string", "pattern": "^prop_[A-Za-z0-9_-]{8,64}$" },
    "agent": {
      "enum": ["orchestrator", "agent-builder", "software-architect", "open-meteo-integrator", "pwa-mobile-engineer",
        "security-engineer", "agent-console-engineer", "ui-designer-apple-liquid-glass", "ux-designer-apple-hig",
        "qa-engineer", "netlify-engineer"]
    },
    "status": { "enum": ["pending", "committed", "rejected", "stale"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "decidedAt": { "type": "string", "format": "date-time" },
    "baseSha": { "$ref": "#/$defs/sha1", "description": "main head SHA the agent read from" },
    "summary": { "type": "string", "minLength": 20, "maxLength": 2000, "description": "What, why, how tested (change-proposal-protocol)" },
    "files": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "content"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Allow-listed path (docs/04 §6). Rejects '..', absolute paths, backslashes and every DENY prefix.",
            "allOf": [
              { "pattern": "^(public/[^\\\\]+|tests/[^\\\\]+|docs/[^\\\\]+|\\.claude/agents/[^/\\\\]+\\.md|\\.claude/skills/[^\\\\]+\\.md)$" },
              { "not": { "pattern": "(^|/)\\.\\.(/|$)" } },
              { "not": { "pattern": "(^|/)\\.env" } }
            ]
          },
          "content": { "type": "string", "maxLength": 204800, "description": "Complete new file contents (text only). maxLength counts characters; the server also checks bytes." },
          "readBlobSha": { "anyOf": [{ "$ref": "#/$defs/sha1" }, { "type": "null" }], "description": "Blob SHA the agent read; null for a new file. Used for the stale check." }
        }
      }
    },
    "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "Hash of files the user saw; recomputed at approve" },
    "commitSha": { "$ref": "#/$defs/sha1" },
    "rejectReason": { "type": "string", "maxLength": 500 }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "committed" } } }, "then": { "required": ["commitSha", "decidedAt"] } },
    { "if": { "properties": { "status": { "const": "rejected" } } }, "then": { "required": ["decidedAt"] } },
    { "if": { "properties": { "status": { "enum": ["pending", "stale", "rejected"] } } }, "then": { "not": { "required": ["commitSha"] } } }
  ],
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}
