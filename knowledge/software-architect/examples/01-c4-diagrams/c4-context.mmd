    nws["National Weather Service<br/>[External System]<br/>Beach and surf-zone forecasts"]

    beachgoer -- "Views verdicts<br/>[HTTPS]" --> beachday
    drlee -- "Chats, reviews diffs, clicks Approve<br/>[HTTPS, password gate]" --> beachday
