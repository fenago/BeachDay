    auth -- "throttle counters" --> blobs
    chat -- "proposals, rate limits" --> blobs
    jobs -- "job events, proposals" --> blobs
    approve -- "CAS status, audit" --> blobs
    approve -- "One atomic commit to main<br/>[Git Database API, GITHUB_TOKEN]" --> github

