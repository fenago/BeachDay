            direction LR
            auth["login / logout<br/>[sync]"]
            chat["chat<br/>[sync, SSE ≤60 s]"]
            jobs["jobs<br/>[background ≤15 min]"]
            approve["proposals / approve<br/>[sync]"]
        end
        blobs[("Netlify Blobs<br/>[Container: key-value stores]<br/>proposals, jobs, ratelimit, audit<br/>strong consistency for state")]
    end

    openmeteo["Open-Meteo<br/>[External System]"]
    claude["Claude API<br/>[External System]"]
    github["GitHub<br/>[External System]"]
    nws["NWS<br/>[External System]"]

    beachgoer -- "Uses [HTTPS]" --> pwa
