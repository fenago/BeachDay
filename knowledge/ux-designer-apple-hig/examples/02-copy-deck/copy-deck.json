{
  "$comment": "Beach Day copy deck (example). {placeholders} are filled at runtime. Verdict/reason wording changes need open-meteo-integrator review. Checked by check-copy.mjs. Reason ids map to Dewey's reason codes (docs/01 5.2); auth and Console ids are in the console group.",
  "rules": {
    "limits": {
      "verdict": 24,
      "verdictShort": 10,
      "reason": 36,
      "advice": 60,
      "status": 60,
      "error": 90,
      "button": 22,
      "console": 90,
      "safety": 100
    },
    "minFlesch": 60,
    "minWordsForFlesch": 5,
    "bannedWords": [
      "we",
      "we're",
      "our",
      "oops",
      "uh-oh",
      "click",
      "sorry",
      "invalid",
      "error",
      "loading"
    ],
    "buttonCase": "title",
    "textCase": "sentence"
  },
  "safety": {
    "id": "safety.line",
    "text": "Beach Day is not a safety service — check NWS rip-current risk and posted beach flags.",
