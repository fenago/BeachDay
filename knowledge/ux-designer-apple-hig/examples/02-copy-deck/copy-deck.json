{
  "$comment": "Beach Day copy deck (example). {placeholders} are filled at runtime. Verdict/reason wording changes need open-meteo-integrator review. Checked by check-copy.mjs.",
  "rules": {
    "limits": {
      "verdict": 24,
      "verdictShort": 10,
      "reason": 36,
      "advice": 60,
      "status": 60,
      "error": 90,
      "button": 22,
      "console": 90,
      "safety": 100
    },
    "minFlesch": 60,
    "minWordsForFlesch": 5,
    "bannedWords": [
      "we",
      "we're",
      "our",
      "oops",
      "uh-oh",
      "click",
      "sorry",
      "invalid",
      "error",
      "loading"
    ],
    "buttonCase": "title",
    "textCase": "sentence"
  },
  "safety": {
    "id": "safety.line",
    "text": "Beach Day is not a safety service — check NWS rip-current risk and posted beach flags.",
    "linkText": "NWS rip-current risk"
  },
  "verdicts": [
    {
      "id": "verdict.great",
      "label": "Great beach day",
      "short": "Great",
      "icon": "sun",
      "band": "80–100"
    },
    {
      "id": "verdict.good",
      "label": "Good",
      "short": "Good",
      "icon": "sun-cloud",
      "band": "65–79"
    },
    {
      "id": "verdict.fair",
      "label": "Fair — pick your hours",
      "short": "Fair",
      "icon": "cloud",
      "band": "45–64"
    },
    {
      "id": "verdict.skip",
      "label": "Skip it",
      "short": "Skip it",
      "icon": "storm",
      "band": "0–44"
    }
  ],
