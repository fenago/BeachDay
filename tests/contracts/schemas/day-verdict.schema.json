{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beachday.example/schemas/day-verdict.schema.json",
  "title": "DayVerdict",
  "description": "One element of loadForecast(...).days (public/js/forecast.js buildDays, open-meteo-integrator) -> the beach UI (pwa-mobile-engineer), worded by public/js/copy/copy-deck.js (ux-designer). scoreDay() output (docs/01 §5.2) plus date, dayIndex, isToday, beachWindow, sunrise and sunset. Times are DST-correct beach wall clock \"HH:MM\". Reasons and advice are codes + copyId + params, never display text. Contract: docs/design/build-contracts.md §3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "dayIndex",
    "isToday",
    "verdict",
    "score",
    "bestWindow",
    "reasons",
    "advice",
    "confidence",
    "seaTempMeanF",
    "numbers",
    "beachWindow",
    "sunrise",
    "sunset"
  ],
  "$defs": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "description": "Placeholder values for t(copyId, params), already rounded for display (docs/01 §5.2 Placeholders). Integers: temp, mph, pct, n, hours. ft one decimal. in two decimals. time is display text such as \"3 pm\" from formatClock().",
      "properties": {
        "time": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12
        },
        "hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "in": {
          "type": "number",
          "minimum": 0
        },
        "temp": {
          "type": "integer",
          "minimum": -40,
          "maximum": 140
        },
        "mph": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "ft": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "n": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "uv": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "copyId",
        "params"
      ],
      "description": "Drivers first (docs/01 §5.2 order), then D3 positives (codes = copy-deck POSITIVE_REASON_IDS keys, copyId reason.pos.*) only when SCORE_CONFIG.reasons.positiveOnGoodDays is true. Status codes only when verdict is null.",
      "properties": {
        "code": {
          "enum": [
            "storm_outside_window",
            "short_window",
            "thunderstorms",
            "thunder_wait",
            "too_windy",
            "dangerous_heat",
            "rain_chance",
            "rain_code",
            "rain_amount",
            "unusual_weather",
            "storm_risk",
            "clouds",
            "feels_like",
            "wind",
            "waves",
            "water_temp",
            "dry",
            "sunny_sky",
            "comfortable",
            "light_wind",
            "calm_waves",
            "warm_water",
            "no_beach_window",
            "data_unavailable"
          ]
        },
        "copyId": {
          "type": "string",
          "pattern": "^(reason|status)\\.[a-z0-9.]+$",
          "description": "Copy-deck id (public/js/copy/copy-deck.js STRINGS). The data layer picks the variant from score-config.js bands, so band edges live in ONE place; the UI renders t(copyId, params) and never re-derives it."
        },
        "params": {
          "$ref": "#/$defs/params"
        },
        "avgPoints": {
          "type": "number",
          "minimum": 0,
          "description": "Mean penalty over the best window (ordering/debug only, never shown)"
        }
      }
    },
    "advice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "copyId",
        "params"
      ],
      "description": "Advice, never scored. lightning pairs with thunderstorms/thunder_wait (docs/01 §5.2).",
      "properties": {
        "code": {
          "enum": [
            "lightning",
            "uv_moderate",
            "uv_high",
            "uv_very_high",
            "uv_extreme",
            "fog",
            "marine_missing",
            "marine_partial"
          ]
        },
        "copyId": {
          "type": "string",
          "pattern": "^advice\\.[a-z0-9.]+$",
          "description": "Copy-deck id (public/js/copy/copy-deck.js STRINGS). The data layer picks the variant from score-config.js bands, so band edges live in ONE place; the UI renders t(copyId, params) and never re-derives it."
        },
        "params": {
          "$ref": "#/$defs/params"
        },
        "avgPoints": {
          "type": "number",
          "minimum": 0,
          "description": "Mean penalty over the best window (ordering/debug only, never shown)"
        }
      }
    },
    "hhmm": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    }
  },
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Beach-local date, America/New_York"
    },
    "dayIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15,
      "description": "0 = today"
    },
    "isToday": {
      "type": "boolean"
    },
    "verdict": {
      "enum": [
        "great",
        "good",
        "fair",
        "skip",
        null
      ],
      "description": "Key, not display text. null = no verdict (window over, or no usable hour)"
    },
    "score": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "rawScore": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100,
      "description": "Optional: score before any cap"
    },
    "bestWindow": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end",
            "hours"
          ],
          "properties": {
            "start": {
              "$ref": "#/$defs/hhmm"
            },
            "end": {
              "$ref": "#/$defs/hhmm"
            },
            "hours": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          }
        }
      ]
    },
    "reasons": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/reason"
      }
    },
    "advice": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/advice"
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "outlook"
      ],
      "description": "docs/01 §5.3; outlook from dayIndex 3 (day 4)"
    },
    "seaTempMeanF": {
      "type": [
        "number",
        "null"
      ]
    },
    "wavesMaxFt": {
      "type": [
        "number",
        "null"
      ],
      "description": "Optional: max offshore wave height in the best window"
    },
    "marineAvailable": {
      "type": "boolean",
      "description": "Optional; the advice marine_missing / marine_partial is what the UI shows"
    },
    "numbers": {
      "description": "Key numbers for the Today card (docs/01 §1), over the best window. null when there is no verdict. A null field means \"unavailable\": the UI says so, never shows 0.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "feelsF",
            "tempF",
            "windMph",
            "gustMph",
            "rainChancePct",
            "rainIn",
            "uv",
            "cloudPct",
            "waveFt",
            "seaTempF"
          ],
          "properties": {
            "feelsF": {
              "type": [
                "number",
                "null"
              ]
            },
            "tempF": {
              "type": [
                "number",
                "null"
              ]
            },
            "windMph": {
              "type": [
                "number",
                "null"
              ]
            },
            "gustMph": {
              "type": [
                "number",
                "null"
              ]
            },
            "rainChancePct": {
              "type": [
                "number",
                "null"
              ]
            },
            "rainIn": {
              "type": [
                "number",
                "null"
              ]
            },
            "uv": {
              "type": [
                "number",
                "null"
              ]
            },
            "cloudPct": {
              "type": [
                "number",
                "null"
              ]
            },
            "waveFt": {
              "type": [
                "number",
                "null"
              ],
              "description": "Label \"offshore waves\""
            },
            "seaTempF": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      ]
    },
    "hourScores": {
      "type": "array",
      "maxItems": 24,
      "description": "Optional: per-hour scores in the beach window (for an hour strip)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "time",
          "score",
          "hardStops"
        ],
        "properties": {
          "time": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00$"
          },
          "score": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "hardStops": {
            "type": "array",
            "items": {
              "enum": [
                "thunderstorms",
                "thunder_wait",
                "too_windy",
                "dangerous_heat"
              ]
            }
          }
        }
      }
    },
    "beachWindow": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "$ref": "#/$defs/hhmm"
            },
            "end": {
              "$ref": "#/$defs/hhmm"
            }
          }
        }
      ]
    },
    "sunrise": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/hhmm"
        }
      ]
    },
    "sunset": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/hhmm"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "verdict"
        ],
        "properties": {
          "verdict": {
            "const": "great"
          }
        }
      },
      "then": {
        "properties": {
          "score": {
            "type": "integer",
            "minimum": 80
          }
        }
      }
    },
    {
      "description": "Good is [65,80), except a short window capped from Great may keep a higher score (docs/01 §5.2 caps the verdict).",
      "if": {
        "required": [
          "verdict"
        ],
        "properties": {
          "verdict": {
            "const": "good"
          }
        }
      },
      "then": {
        "properties": {
          "score": {
            "type": "integer",
            "minimum": 65
          }
        },
        "anyOf": [
          {
            "properties": {
              "score": {
                "type": "integer",
                "maximum": 79
              }
            }
          },
          {
            "required": [
              "bestWindow"
            ],
            "properties": {
              "bestWindow": {
                "type": "object",
                "required": [
                  "hours"
                ],
                "properties": {
                  "hours": {
                    "type": "integer",
                    "maximum": 2
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "required": [
          "verdict"
        ],
        "properties": {
          "verdict": {
            "const": "fair"
          }
        }
      },
      "then": {
        "properties": {
          "score": {
            "type": "integer",
            "minimum": 45,
            "maximum": 64
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "verdict"
        ],
        "properties": {
          "verdict": {
            "const": "skip"
          }
        }
      },
      "then": {
        "properties": {
          "score": {
            "type": "integer",
            "maximum": 44
          }
        }
      }
    },
    {
      "description": "No verdict: no score, no window, exactly one status reason.",
      "if": {
        "required": [
          "verdict"
        ],
        "properties": {
          "verdict": {
            "const": null
          }
        }
      },
      "then": {
        "properties": {
          "score": {
            "type": "null"
          },
          "bestWindow": {
            "type": "null"
          },
          "reasons": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "enum": [
                    "no_beach_window",
                    "data_unavailable"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "description": "Status codes appear only when there is no verdict.",
      "if": {
        "required": [
          "verdict"
        ],
        "properties": {
          "verdict": {
            "enum": [
              "great",
              "good",
              "fair",
              "skip"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reasons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "not": {
                    "enum": [
                      "no_beach_window",
                      "data_unavailable"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "description": "A window shorter than 3 hours never earns Great and always says so (docs/01 §5.2).",
      "if": {
        "required": [
          "bestWindow"
        ],
        "properties": {
          "bestWindow": {
            "type": "object",
            "required": [
              "hours"
            ],
            "properties": {
              "hours": {
                "type": "integer",
                "maximum": 2
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "verdict": {
            "enum": [
              "good",
              "fair",
              "skip"
            ]
          },
          "reasons": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": [
                "code"
              ],
              "properties": {
                "code": {
                  "const": "short_window"
                }
              }
            }
          }
        }
      }
    },
    {
      "description": "Outlook days are dayIndex >= 3.",
      "if": {
        "required": [
          "dayIndex"
        ],
        "properties": {
          "dayIndex": {
            "type": "integer",
            "minimum": 3
          }
        }
      },
      "then": {
        "properties": {
          "confidence": {
            "const": "outlook"
          }
        }
      }
    }
  ]
}
