{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beachday.example/schemas/agents-response.schema.json",
  "title": "AgentsResponse",
  "description": "200 body of GET /api/agents (agents.mts, from the bundled agents.json written by scripts/build-agents.mjs) -> Console Agents page (console/agents.js). Each element is the agents.json element WITHOUT systemPrompt (additionalProperties false makes a leaked prompt fail). Sorted by name. Contract: docs/design/build-contracts.md §4 and §12.",
  "type": "object",
  "additionalProperties": false,
  "required": ["agents"],
  "properties": {
    "agents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/agent" },
      "contains": { "type": "object", "required": ["teamLead"], "properties": { "teamLead": { "const": true } } },
      "minContains": 0,
      "maxContains": 1,
      "description": "At most one agent carries teamLead (Ask the team, build-contracts §12). None is allowed: the UI then shows the plain list."
    }
  },
  "$defs": {
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "persona", "description", "personality", "model", "modelLabel", "color", "skills", "knowledge"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
        "teamLead": { "const": true, "description": "Present (true) only on SETTINGS.team.leadAgent. The UI keys the 'Ask the team' card on this flag, never on the name. Never false: absent means expert" },
        "persona": { "type": "string", "minLength": 1, "maxLength": 40, "description": "First name; falls back to name" },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "personality": { "type": "string", "minLength": 1, "maxLength": 2000, "description": "Falls back to description" },
        "model": { "enum": ["claude-opus-5-5", "claude-sonnet-5-5", "claude-haiku-5-5"] },
        "modelLabel": { "enum": ["Opus", "Sonnet", "Haiku"], "description": "Badge text; never colour alone" },
        "color": { "type": ["string", "null"], "pattern": "^[a-z-]{1,20}$", "description": "Decoration only" },
        "skills": { "type": "array", "maxItems": 40, "items": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" } },
        "knowledge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "title", "docs", "examples"],
          "properties": {
            "path": { "type": "string", "pattern": "^knowledge/[a-z][a-z0-9-]{1,63}/$" },
            "title": { "$ref": "#/$defs/title" },
            "docs": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false, "required": ["file", "title"],
                "properties": { "file": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,100}\\.md$", "description": "Bare file name under <path>docs/" }, "title": { "$ref": "#/$defs/title" } }
              }
            },
            "examples": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false, "required": ["dir", "title"],
                "properties": { "dir": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,100}$", "description": "Bare folder name under <path>examples/" }, "title": { "$ref": "#/$defs/title" } }
              }
            }
          }
        }
      }
    }
  }
}
