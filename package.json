{
  "name": "beach-day",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Beach Day: a South Florida beach-day PWA with an Agent Console.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/contracts tests/static",
    "test:functions": "vitest run tests/functions tests/db",
    "e2e": "playwright test --trace off",
    "serve:harness": "node tests/harness/server.mjs",
    "build:agents": "node scripts/build-agents.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@netlify/blobs": "11.1.10",
    "@supabase/auth-js": "2.119.2",
    "diff": "9.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.6.0",
    "@playwright/test": "1.63.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "msw": "3.0.7",
    "vitest": "5.1.1"
  }
}
